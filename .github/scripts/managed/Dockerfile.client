ARG BROWSER_IMAGE=browser-sandbox:managed
FROM ${BROWSER_IMAGE}
USER root
WORKDIR /project
COPY .github/scripts/managed/client/package*.json /project/.github/scripts/e2e/
RUN npm ci --prefix /project/.github/scripts/e2e --omit=dev
ENV BROWSER_PACKAGE_ROOT=/opt/browser-sandbox
USER 100001:100001
ENTRYPOINT ["node"]
