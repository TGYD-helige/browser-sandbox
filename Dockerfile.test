FROM node:24-bookworm-slim
WORKDIR /project
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json ./
COPY src ./src
COPY skills ./skills
COPY scripts/copy-assets.mjs ./scripts/copy-assets.mjs
COPY tests ./tests
COPY adapters/cloudflare-worker/index.js ./adapters/cloudflare-worker/index.js
COPY config ./config
COPY .github/scripts/benchmark-*.mjs .github/scripts/compare-performance.mjs .github/scripts/check-image-tag.sh .github/scripts/check-release-tag.sh .github/scripts/publish-release.sh ./.github/scripts/
RUN pnpm build
CMD ["node", "--test", "--test-timeout=60000", "tests/*.test.mjs"]
